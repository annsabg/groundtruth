{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundtruth.dev/schema/source.schema.json",
  "title": "Source",
  "type": "object",
  "properties": {
    "source_id": {"type": "string"},
    "mission_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "One source can cover multiple missions (e.g. a compiled PDF spanning several crews)."
    },
    "url_or_reference": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["official_report", "crew_blog", "pdf", "compiled_pdf", "other"]
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["events", "crew", "research"]},
      "description": "What kind(s) of data this source can supply."
    },
    "date_range_or_sols": {"type": "string"},
    "discovery_method": {"enum": ["agent", "manual"]},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_date": {"type": "string", "format": "date"}
  },
  "required": [
    "source_id", "mission_ids", "url_or_reference", "source_type",
    "covers", "discovery_method", "approved_by", "approved_date"
  ],
  "additionalProperties": false
}
