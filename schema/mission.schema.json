{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundtruth.dev/schema/mission.schema.json",
  "title": "Mission",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{4}$",
      "description": "Format {STATION}-{CREW_DESIGNATION}-{YEAR}, e.g. FMARS-C16-2024. Multi-site missions (e.g. MARS160-2017) omit a station prefix since the crew designation carries the identity."
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["FMARS", "MDRS", "LunAres", "HI-SEAS", "AMADEE", "Other"]
      }
    },
    "stations_other_detail": {
      "type": "string",
      "description": "Required elaboration when 'stations' includes 'Other' (design spec §4.1: 'Other (+ free text if Other)'). Not otherwise used."
    },
    "crew_designation": {"type": "string", "minLength": 1},
    "institutional_or_volunteer": {"enum": ["institutional", "volunteer"]},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "location": {"type": "string"},
    "mission_goal": {"type": "string"},
    "crew_size": {"type": "integer", "minimum": 0},
    "source_citation": {"type": "string", "minLength": 1},
    "verified_by": {"type": "string", "minLength": 1}
  },
  "required": [
    "mission_id", "stations", "crew_designation", "institutional_or_volunteer",
    "start_date", "end_date", "crew_size", "source_citation", "verified_by"
  ],
  "if": {
    "properties": {"stations": {"contains": {"const": "Other"}}}
  },
  "then": {
    "required": ["stations_other_detail"]
  },
  "additionalProperties": false
}
